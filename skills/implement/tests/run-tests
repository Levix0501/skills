t08_carried_rereview_verdict_closes_open_set() {
  ledger="$TMPROOT/carried-rereview-ledger.md"
  cat >"$ledger" <<'EOF'
# Implement ledger — /tmp/spec.md
Phase 1: review — carried
F3 | minor | preserve the compatibility behavior
Phase 1: accepted — R1 — carry F3
Phase 2: carried verdicts — F3 not_addressed
Phase 2: review — blocking
F4 | important | required behavior is incomplete
Phase 2: fix round 1 — /tmp/repo aaa1111..bbb2222 — verified: pass
Phase 2: re-review 1 — verdicts — F4 addressed; F3 addressed
Phase 2: re-review 1 — clean
Phase 2: accepted — R2
EOF

  [ "$(grep -c '^F3 | minor |' "$ledger")" -eq 1 ] || return 1
  open=$(awk '
    /accepted .* carry .*F3/ { open = 1 }
    /carried verdicts/ && /F3 not_addressed(;|$)/ { open = 1 }
    /(carried verdicts|re-review .* verdicts)/ && /F3 (addressed|invalid)(;|$)/ { open = 0 }
    END { print open + 0 }
  ' "$ledger")
  [ "$open" -eq 0 ]
}

t09_final_coverage_is_paired_with_current_heads() {
  ledger="$TMPROOT/final-coverage-ledger.md"
  cat >"$ledger" <<'EOF'
# Implement ledger — /tmp/spec.md
Phase 2: final review repositories — /tmp/repo [aaa1111..bbb2222]
Phase 2: review — final findings — coverage: R1; A1
F7 | minor | quality: remove the stale fallback
Phase 2: fix round 1 repositories — /tmp/repo [main@bbb2222]
Phase 2: fix round 1 — /tmp/repo bbb2222..ccc3333 — verified: pass
Phase 2: re-review 1 repositories — /tmp/repo [aaa1111..ccc3333]
Phase 2: re-review 1 — clean — coverage: R1; A1
EOF

  current_head=ccc3333
  ranges_line=$(grep -n 're-review 1 repositories' "$ledger" | tail -1 | cut -d: -f1)
  coverage_line=$(grep -n 're-review 1 — clean — coverage:' "$ledger" | tail -1 | cut -d: -f1)
  latest_ranges=$(sed -n "${ranges_line}p" "$ledger")
  [ "$ranges_line" -lt "$coverage_line" ] || return 1
  case "$latest_ranges" in *"..$current_head]"*) return 0;; esac
  return 1
}

t10_implement_directory_supports_non_git_workspace() {
  repo="$TMPROOT/implement-directory"
  mkdir -p "$repo/docs/specs" "$repo/projects/a"
  (
    cd "$repo" || exit 1
    printf '# Spec\n' > docs/specs/example.md
    git -C projects/a init -q -b main
    cd projects/a || exit 1
    dir=$($IMPLEMENT_DIRECTORY ../../docs/specs/example.md)
    [ "$dir" = "$repo/docs/specs/.implement/example" ] || exit 1
    [ -d "$dir" ] || exit 1
    [ "$(cat "$repo/docs/specs/.implement/.gitignore")" = '*' ] || exit 1
    [ ! -e "$dir/progress.md" ] || exit 1
    again=$($IMPLEMENT_DIRECTORY "$repo/docs/specs/example.md")
    [ "$again" = "$dir" ]
  )
}

t11_review_package_is_temporary_and_multi_repo() {
  repo="$TMPROOT/review-package"
  mkdir -p "$repo/docs/specs" "$repo/projects/a" "$repo/projects/b"
  (
    cd "$repo" || exit 1
    printf '# Spec\n' > docs/specs/example.md
    for child in projects/a projects/b; do
      git -C "$child" init -q -b main
      git -C "$child" config user.name test
      git -C "$child" config user.email test@example.com
      printf 'base\n' > "$child/work.txt"
      git -C "$child" add work.txt
      git -C "$child" commit -qm base
    done
    base_a=$(git -C projects/a rev-parse HEAD)
    base_b=$(git -C projects/b rev-parse HEAD)
    printf 'alpha\n' >> projects/a/work.txt
    git -C projects/a add work.txt && git -C projects/a commit -qm alpha
    printf 'beta\n' >> projects/b/work.txt
    git -C projects/b add work.txt && git -C projects/b commit -qm beta
    out=$($REVIEW_PACKAGE docs/specs/example.md "$repo/projects/a" "$base_a" HEAD "$repo/projects/b" "$base_b" HEAD)
    path=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): 2 repository(ies), 2 commit(s), .*$/\1/p')
    [ -n "$path" ] || exit 1
    case "$path" in "$repo"/*) exit 1;; esac
    grep -qF "## Repository: $repo/projects/a" "$path" || exit 1
    grep -qF "## Repository: $repo/projects/b" "$path" || exit 1
    grep -q '^+alpha$' "$path" || exit 1
    grep -q '^+beta$' "$path" || exit 1
    rm -f "$path"
  )
}

