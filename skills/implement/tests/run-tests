t07_implement_directory_supports_non_git_workspace() {
  local repo="$TMPROOT/implement-directory"
  mkdir -p "$repo/docs/specs" "$repo/projects/a"
  (
    cd "$repo" || exit 1
    printf '# Spec\n' > docs/specs/example.md
    git -C projects/a init -q -b main

    cd projects/a || exit 1
    dir=$($IMPLEMENT_DIRECTORY ../../docs/specs/example.md)
    [ "$dir" = "$repo/docs/specs/.implement/example" ] || exit 1
    [ -d "$dir" ] || exit 1
    [ "$(cat "$repo/docs/specs/.implement/.gitignore")" = '*' ] || exit 1
    [ ! -e "$dir/progress.md" ] || exit 1

    again=$($IMPLEMENT_DIRECTORY "$repo/docs/specs/example.md")
    [ "$again" = "$dir" ]
  )
}

t08_implement_directory_handles_input_without_layout_gate() {
  local repo="$TMPROOT/implement-directory-bad-input"
  mkdir -p "$repo"
  (
    cd "$repo" || exit 1
    rc=0
    "$IMPLEMENT_DIRECTORY" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || exit 1
    rc=0
    "$IMPLEMENT_DIRECTORY" missing.md >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || exit 1
    [ ! -e "$repo/.implement" ] || exit 1

    mkdir -p notes
    printf '# External spec\n' > notes/example.txt
    dir=$("$IMPLEMENT_DIRECTORY" notes/example.txt)
    [ "$dir" = "$repo/notes/.implement/example.txt" ]
  )
}

t09_review_package_covers_multiple_repositories() {
  local repo="$TMPROOT/repo"
  mkdir -p "$repo/docs/specs" "$repo/projects/a" "$repo/projects/b"
  (
    cd "$repo" || exit 1
    git init -q -b main
    git config user.name test
    git config user.email test@example.com
    printf '# Spec\n' > docs/specs/example.md

    for child in projects/a projects/b; do
      git -C "$child" init -q -b main
      git -C "$child" config user.name test
      git -C "$child" config user.email test@example.com
      printf 'base\n' > "$child/work.txt"
      git -C "$child" add work.txt
      git -C "$child" commit -qm base
    done

    base_a=$(git -C projects/a rev-parse HEAD)
    base_b=$(git -C projects/b rev-parse HEAD)
    printf 'alpha\n' >> projects/a/work.txt
    git -C projects/a add work.txt && git -C projects/a commit -qm alpha
    printf 'beta\n' >> projects/b/work.txt
    git -C projects/b add work.txt && git -C projects/b commit -qm beta

    out=$($REVIEW_PACKAGE docs/specs/example.md "$repo/projects/a" "$base_a" HEAD "$repo/projects/b" "$base_b" HEAD)
    path=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): 2 repository(ies), 2 commit(s), .*$/\1/p')
    [ -n "$path" ] || exit 1
    grep -qF "## Repository: $repo/projects/a" "$path" || exit 1
    grep -qF "## Repository: $repo/projects/b" "$path" || exit 1
    grep -q ' alpha$' "$path" || exit 1
    grep -q ' beta$' "$path" || exit 1
    grep -q '^+alpha$' "$path" || exit 1
    grep -q '^+beta$' "$path" || exit 1
  )
}

t10_review_package_rejects_bad_input() {
  local repo="$TMPROOT/bad-input"
  mkdir -p "$repo"
  (
    cd "$repo" || exit 1
    git init -q -b main
    git config user.name test
    git config user.email test@example.com
    printf 'x\n' > x
    git add x && git commit -qm base
    rc=0
    "$REVIEW_PACKAGE" missing.md "$repo" HEAD HEAD >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || exit 1
    rc=0
    "$REVIEW_PACKAGE" x "$repo" HEAD >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ]
  )
}

t11_flow_precedes_nine_ordered_steps() {
  local previous current heading
  previous=$(grep -nF '## Flow' "$SKILL" | head -1 | cut -d: -f1)
  current=$(grep -nF '## Rules throughout' "$SKILL" | head -1 | cut -d: -f1)
  [ "$current" -gt "$previous" ] || return 1
  previous=$current
  for heading in \
    '## 1. Resolve spec' \
    '## 2. Preconditions' \
    '## 3. Progress' \
    '## 4. Choose the current phase' \
    '## 5. Phase loop' \
    '## 6. Review, fix and re-review' \
    '## 7. User gate' \
    '## 8. Finish' \
    '## 9. Resume'
  do
    current=$(grep -nF "$heading" "$SKILL" | head -1 | cut -d: -f1)
    [ -n "$current" ] && [ "$current" -gt "$previous" ] || return 1
    previous=$current
  done
  [ "$(grep -cE '^## [1-9]\. ' "$SKILL")" -eq 9 ]
}

TESTS='t01_only_two_helpers_remain
t02_ledger_is_the_live_record
t03_rolling_phase_planning
t04_role_templates_point_at_the_files
t05_review_fix_gate_contracts_remain
t06_legacy_task_machinery_is_gone
t07_implement_directory_supports_non_git_workspace
t08_implement_directory_handles_input_without_layout_gate
t09_review_package_covers_multiple_repositories
t10_review_package_rejects_bad_input
t11_flow_precedes_nine_ordered_steps'

for test_name in $TESTS; do
  if (set -e; "$test_name"); then
    pass "$test_name"
  else
    fail "$test_name"
  fi
done

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
