t14_recovery_manifest_pins_and_checks_heads() {
  repo="$TMPROOT/recovery-head-repo"
  manifest="$TMPROOT/recovery-manifest.md"
  evidence="$TMPROOT/recovery-evidence.md"
  missing_head="$TMPROOT/recovery-missing-head.md"
  wrong_evidence="$TMPROOT/recovery-wrong-evidence.md"
  mkdir -p "$repo"
  git -C "$repo" init -q -b main
  git -C "$repo" config user.name test
  git -C "$repo" config user.email test@example.com
  printf 'base\n' >"$repo/work.txt"
  git -C "$repo" add work.txt
  git -C "$repo" commit -qm base
  head=$(git -C "$repo" rev-parse HEAD)

  cat >"$manifest" <<EOF
# Dispatch
Manifest version: 1
Role: implementer
Mode: final
Action: evidence-recovery
Phase: P2
Generation: D3
REPOSITORY:
Path: $repo
Branch: main
Base: $head
Head: $head
END_REPOSITORY
Manifest-complete: yes
EOF
  cat >"$evidence" <<EOF
# Evidence
REPOSITORY:
Path: $repo
Branch: main
Base: $head
Head: $head
Tests: suite passed
END_REPOSITORY
Integration: n/a
Acceptance: A1 passed
Evidence-complete: yes
EOF

  recovery_manifest_valid "$manifest" || return 1
  recovery_evidence_matches_manifest "$manifest" "$evidence" || return 1

  sed '/^Head: /d' "$manifest" >"$missing_head"
  if recovery_manifest_valid "$missing_head"; then return 1; fi

  sed 's/^Head: .*/Head: 0000000000000000000000000000000000000000/' "$evidence" >"$wrong_evidence"
  if recovery_evidence_matches_manifest "$manifest" "$wrong_evidence"; then return 1; fi

  printf 'drift\n' >>"$repo/work.txt"
  git -C "$repo" add work.txt
  git -C "$repo" commit -qm drift
  if recovery_manifest_valid "$manifest"; then return 1; fi
}

