#!/usr/bin/env bash
# Acceptance tests for the implement skill and its two deterministic helpers.
set -u

HERE=$(cd "$(dirname "$0")" && pwd -P)
SKILL="$HERE/../SKILL.md"
AGENTS="$HERE/../agents"
SCRIPTS="$HERE/../scripts"
IMPLEMENT_DIRECTORY="$SCRIPTS/implement-directory"
REVIEW_PACKAGE="$SCRIPTS/review-package"
README="$HERE/../../../README.md"

TMPROOT=$(mktemp -d "${TMPDIR:-/tmp}/implement-tests.XXXXXX")
TMPROOT=$(CDPATH= cd -- "$TMPROOT" && pwd -P)
trap 'rm -rf "$TMPROOT"' EXIT

PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
fail() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }
contains() { grep -qF "$2" "$1"; }
not_contains() { ! grep -qF "$2" "$1"; }

t01_layout_stays_lean() {
  [ -x "$IMPLEMENT_DIRECTORY" ] || return 1
  [ -x "$REVIEW_PACKAGE" ] || return 1
  [ "$(find "$SCRIPTS" -maxdepth 1 -type f | wc -l | tr -d ' ')" = 2 ] || return 1
  [ ! -e "$AGENTS/runtime" ] || return 1
  [ "$(find "$AGENTS" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')" = 4 ]
}

t02_skill_routes_compact_dispatch() {
  contains "$SKILL" 'name: implement' || return 1
  contains "$SKILL" 'role-contract path, dispatch-manifest path' || return 1
  contains "$SKILL" 'Keep this prompt below 1 KB.' || return 1
  contains "$SKILL" 'Complete finding lines are forbidden in manifests' || return 1
  contains "$SKILL" 'Append a ruling only for semantic changes' || return 1
  contains "$SKILL" 'not a routine package-path refresh' || return 1
  contains "$SKILL" 'The controller alone writes `PROGRESS_FILE` and dispatch manifests.' || return 1
  contains "$SKILL" 'Implementer and fixer may write only their manifest-named evidence path' || return 1
  not_contains "$SKILL" "fill the named agent template's placeholders" || return 1
  not_contains "$SKILL" 'prompt: |' || return 1

  prompt=$(printf 'Read and follow the role contract:\n%s\n\nExecute this dispatch:\n%s\n\nReturn only the format required by the role contract.\n' \
    '/skills/implement/agents/implementer.md' '/tmp/run/dispatch/P1-implement-D1.md')
  prompt_bytes=$(printf '%s' "$prompt" | wc -c | tr -d ' ')
  [ "$prompt_bytes" -lt 1024 ] || return 1
  for historical_build_bytes in 28000 62000 71000; do
    [ "$prompt_bytes" -lt "$historical_build_bytes" ] || return 1
  done
}

t03_manifest_and_evidence_contracts_are_complete() {
  for value in \
    'Manifest version: 1' \
    'Role: implementer|reviewer|fixer|re-reviewer' \
    'Mode: intermediate|final' \
    'Action: execute|evidence-recovery' \
    'Scope: brief: <path>' \
    'Manifest-complete: yes' \
    'incoming carried ids grouped by ledger source anchor' \
    'supplied finding ids grouped by source anchor' \
    'new-finding admission rule'
  do
    contains "$SKILL" "$value" || return 1
  done

  contains "$SKILL" 'Evidence-complete: yes' || return 1
  contains "$SKILL" 'REPOSITORY:' || return 1
  contains "$SKILL" 'Tests: <commands and results for this repository>' || return 1
  contains "$SKILL" 'Repeat the repository block; keep integration and acceptance build-wide.' || return 1
  contains "$SKILL" '`Action: evidence-recovery` is implementer/fixer-only.' || return 1
  contains "$SKILL" 'evidence without `Evidence-complete: yes`' || return 1
}

t04_roles_are_runtime_contracts() {
  for role in implementer reviewer fixer re-reviewer; do
    file="$AGENTS/$role.md"
    [ -s "$file" ] || return 1
    contains "$file" 'Manifest version: 1' || return 1
    contains "$file" 'Manifest-complete: yes' || return 1
    not_contains "$file" 'Prompt Template' || return 1
    not_contains "$file" 'Subagent (general-purpose):' || return 1
    not_contains "$file" 'run_in_background:' || return 1
    ! grep -qE '\[[A-Z][A-Z_]+\]' "$file" || return 1
  done

  contains "$AGENTS/implementer.md" 'Mode: intermediate' || return 1
  contains "$AGENTS/implementer.md" 'Mode: final' || return 1
  contains "$AGENTS/implementer.md" 'Action: evidence-recovery' || return 1
  contains "$AGENTS/implementer.md" 'only the exact evidence output path' || return 1
  contains "$AGENTS/implementer.md" 'Phase: P<n>' || return 1
  contains "$AGENTS/fixer.md" 'resolve every supplied finding, including Minor' || return 1
  contains "$AGENTS/fixer.md" 'any participating authorized repository' || return 1
  contains "$AGENTS/reviewer.md" 'CARRIED_VERDICTS:' || return 1
  contains "$AGENTS/reviewer.md" 'perform the one unrestricted whole-spec review' || return 1
  contains "$AGENTS/re-reviewer.md" 'only findings caused by the fix wave' || return 1
  contains "$AGENTS/re-reviewer.md" 'must name the exact requirement' || return 1
  contains "$AGENTS/re-reviewer.md" 'this is not permission for a fresh whole-diff scan' || return 1
}

t05_carried_state_is_closed() {
  contains "$SKILL" 'Phase <n>: review — carried' || return 1
  contains "$SKILL" 'Phase <n>: accepted — <satisfied scope> — carry <finding ids>' || return 1
  contains "$SKILL" 'Phase <n>: carried verdicts' || return 1
  contains "$SKILL" '`not_addressed` remains open.' || return 1
  contains "$SKILL" 'Completion rejects any carried id without one unique source line, reviewer verdict, or final owner.' || return 1
  contains "$SKILL" 'Minor-only, including `not_addressed` carried ids: append `review — carried`' || return 1
  contains "$SKILL" 'including on a clean or blocking review' || return 1
  contains "$SKILL" 'including Minor and `not_addressed` carried ids' || return 1
  contains "$SKILL" 'every original `not_addressed` or new Minor is carried' || return 1
  contains "$SKILL" 'Anchor each newly admitted re-review finding exactly once' || return 1
  contains "$SKILL" 'Complete `review — carried` without accepted line' || return 1
  not_contains "$SKILL" 'Record each Minor as `Phase <n>: review: minor deferred' || return 1
}

t06_final_review_converges() {
  contains "$SKILL" 'one unrestricted whole-spec review at current heads' || return 1
  contains "$SKILL" 'one cumulative package covering every participating repository' || return 1
  contains "$SKILL" 'Any final finding, including Minor' || return 1
  contains "$SKILL" 'A final `not_addressed` id keeps its original source line' || return 1
  contains "$SKILL" 'A Minor-only result after re-review 1 authorizes ordinal round 2 once.' || return 1
  contains "$SKILL" 'Any user-authorized round 2 consumes that allowance' || return 1
  contains "$SKILL" 'no later round is automatic' || return 1
  contains "$SKILL" 'parks all round-1 Critical/Important findings' || return 1
  contains "$SKILL" 'names the exact requirement, acceptance criterion, integration, compatibility, or safety coverage claim' || return 1
  contains "$SKILL" 'affects no requirement, acceptance criterion, compatibility promise, or safety property' || return 1
  contains "$SKILL" 'Ruling: parked by controller' || return 1
  contains "$SKILL" 'Only the user may accept/defer Critical or Important risk' || return 1
  contains "$SKILL" 'review — final findings — coverage:' || return 1
  contains "$SKILL" 'review — final clean — coverage:' || return 1
  contains "$SKILL" 'findings first admitted in that round' || return 1
  contains "$SKILL" 'Acceptance-evidence sources are the manifest' || return 1
  not_contains "$SKILL" 'coverage-index file' || return 1
}

t07_resume_handles_artifact_loss() {
  contains "$SKILL" 'Reuse a complete manifest after a crash only when state and every referenced input are unchanged.' || return 1
  contains "$SKILL" 'never edit the prior file' || return 1
  contains "$SKILL" 'append a recovery ruling and create the next generation' || return 1
  contains "$SKILL" 'Missing temporary package' || return 1
  contains "$SKILL" 'without a routine ruling' || return 1
  contains "$SKILL" 'Missing, malformed, or schema-invalid evidence' || return 1
  contains "$SKILL" 'never substitute the ledger summary' || return 1
  contains "$SKILL" 'do not rerun review' || return 1
  contains "$SKILL" 'No requirements but open carried ids' || return 1
  contains "$SKILL" 'A terminal ledger never resumes automatically.' || return 1
  contains "$SKILL" 'do not infer acceptance from trailers alone' || return 1
}

t08_implement_directory_supports_non_git_workspace() {
  repo="$TMPROOT/implement-directory"
  mkdir -p "$repo/docs/specs" "$repo/projects/a"
  (
    cd "$repo" || exit 1
    printf '# Spec\n' > docs/specs/example.md
    git -C projects/a init -q -b main
    cd projects/a || exit 1
    dir=$($IMPLEMENT_DIRECTORY ../../docs/specs/example.md)
    [ "$dir" = "$repo/docs/specs/.implement/example" ] || exit 1
    [ -d "$dir" ] || exit 1
    [ "$(cat "$repo/docs/specs/.implement/.gitignore")" = '*' ] || exit 1
    [ ! -e "$dir/progress.md" ] || exit 1
    again=$($IMPLEMENT_DIRECTORY "$repo/docs/specs/example.md")
    [ "$again" = "$dir" ]
  )
}

t09_review_package_is_temporary_and_multi_repo() {
  repo="$TMPROOT/review-package"
  mkdir -p "$repo/docs/specs" "$repo/projects/a" "$repo/projects/b"
  (
    cd "$repo" || exit 1
    printf '# Spec\n' > docs/specs/example.md
    for child in projects/a projects/b; do
      git -C "$child" init -q -b main
      git -C "$child" config user.name test
      git -C "$child" config user.email test@example.com
      printf 'base\n' > "$child/work.txt"
      git -C "$child" add work.txt
      git -C "$child" commit -qm base
    done
    base_a=$(git -C projects/a rev-parse HEAD)
    base_b=$(git -C projects/b rev-parse HEAD)
    printf 'alpha\n' >> projects/a/work.txt
    git -C projects/a add work.txt && git -C projects/a commit -qm alpha
    printf 'beta\n' >> projects/b/work.txt
    git -C projects/b add work.txt && git -C projects/b commit -qm beta
    out=$($REVIEW_PACKAGE docs/specs/example.md "$repo/projects/a" "$base_a" HEAD "$repo/projects/b" "$base_b" HEAD)
    path=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): 2 repository(ies), 2 commit(s), .*$/\1/p')
    [ -n "$path" ] || exit 1
    case "$path" in "$repo"/*) exit 1;; esac
    grep -qF "## Repository: $repo/projects/a" "$path" || exit 1
    grep -qF "## Repository: $repo/projects/b" "$path" || exit 1
    grep -q '^+alpha$' "$path" || exit 1
    grep -q '^+beta$' "$path" || exit 1
    rm -f "$path"
  )
}

t10_helpers_reject_bad_input() {
  repo="$TMPROOT/bad-input"
  mkdir -p "$repo"
  (
    cd "$repo" || exit 1
    git init -q -b main
    git config user.name test
    git config user.email test@example.com
    printf 'x\n' > x
    git add x && git commit -qm base
    rc=0
    "$IMPLEMENT_DIRECTORY" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || exit 1
    rc=0
    "$REVIEW_PACKAGE" missing.md "$repo" HEAD HEAD >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ] || exit 1
    rc=0
    "$REVIEW_PACKAGE" x "$repo" HEAD >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 2 ]
  )
}

t11_readme_describes_closure_and_recovery() {
  contains "$README" 'carried Minor findings' || return 1
  contains "$README" 'whole-spec final review' || return 1
  grep -qiF 'immutable dispatch manifests' "$README" || return 1
  contains "$README" 'agent-owned evidence' || return 1
}

t12_nine_sections_remain_ordered() {
  previous=$(grep -nF '## Flow' "$SKILL" | head -1 | cut -d: -f1)
  for heading in \
    '## 1. Resolve spec' \
    '## 2. Preconditions' \
    '## 3. Progress ledger' \
    '## 4. Choose the current phase' \
    '## 5. Dispatch and implementation' \
    '## 6. Review, fix, and re-review' \
    '## 7. User gate' \
    '## 8. Finish' \
    '## 9. Resume'
  do
    current=$(grep -nF "$heading" "$SKILL" | head -1 | cut -d: -f1)
    [ -n "$current" ] && [ "$current" -gt "$previous" ] || return 1
    previous=$current
  done
  [ "$(grep -cE '^## [1-9]\. ' "$SKILL")" -eq 9 ]
}

TESTS='t01_layout_stays_lean
t02_skill_routes_compact_dispatch
t03_manifest_and_evidence_contracts_are_complete
t04_roles_are_runtime_contracts
t05_carried_state_is_closed
t06_final_review_converges
t07_resume_handles_artifact_loss
t08_implement_directory_supports_non_git_workspace
t09_review_package_is_temporary_and_multi_repo
t10_helpers_reject_bad_input
t11_readme_describes_closure_and_recovery
t12_nine_sections_remain_ordered'

for test_name in $TESTS; do
  if (set -e; "$test_name"); then
    pass "$test_name"
  else
    fail "$test_name"
  fi
done

printf '\n%s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
