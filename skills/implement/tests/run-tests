#!/usr/bin/env bash
# Acceptance tests for the implement skill and its two deterministic helpers.
set -u

HERE=$(cd "$(dirname "$0")" && pwd -P)
SKILL="$HERE/../SKILL.md"
AGENTS="$HERE/../agents"
SCRIPTS="$HERE/../scripts"
IMPLEMENT_DIRECTORY="$SCRIPTS/implement-directory"
REVIEW_PACKAGE="$SCRIPTS/review-package"
README="$HERE/../../../README.md"

TMPROOT=$(mktemp -d "${TMPDIR:-/tmp}/implement-tests.XXXXXX")
TMPROOT=$(CDPATH= cd -- "$TMPROOT" && pwd -P)
trap 'rm -rf "$TMPROOT"' EXIT

PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf 'ok   %s\n' "$1"; }
fail() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$1"; }
contains() { grep -qF "$2" "$1"; }
not_contains() { ! grep -qF "$2" "$1"; }

recovery_manifest_valid() {
  manifest=$1
  records="$TMPROOT/recovery-manifest-records.$$"

  grep -qxF 'Manifest version: 1' "$manifest" || return 1
  grep -Eq '^Role: (implementer|fixer)$' "$manifest" || return 1
  grep -qxF 'Action: evidence-recovery' "$manifest" || return 1
  grep -qxF 'Manifest-complete: yes' "$manifest" || return 1

  awk '
    /^REPOSITORY:$/ {
      if (inside) exit 2
      inside = 1; blocks++; path = branch = base = head = ""
      next
    }
    inside && /^Path: / { path = substr($0, 7); next }
    inside && /^Branch: / { branch = substr($0, 9); next }
    inside && /^Base: / { base = substr($0, 7); next }
    inside && /^Head: / { head = substr($0, 7); next }
    /^END_REPOSITORY$/ {
      if (!inside || path == "" || branch == "" || base == "" || head == "") exit 2
      print path "\t" branch "\t" base "\t" head
      inside = 0
    }
    END { if (inside || blocks == 0) exit 2 }
  ' "$manifest" >"$records" || return 1

  tab=$(printf '\t')
  while IFS="$tab" read -r path branch base head; do
    [ -n "$path" ] && [ -n "$branch" ] && [ -n "$base" ] && [ -n "$head" ] || return 1
    canonical=$(CDPATH= cd -- "$path" 2>/dev/null && pwd -P) || return 1
    [ "$canonical" = "$path" ] || return 1
    [ "$(git -C "$path" branch --show-current)" = "$branch" ] || return 1
    [ "$(git -C "$path" rev-parse HEAD)" = "$head" ] || return 1
    git -C "$path" merge-base --is-ancestor "$base" "$head" || return 1
    [ -z "$(git -C "$path" status --porcelain)" ] || return 1
  done <"$records"
}

recovery_evidence_matches_manifest() {
  manifest=$1
  evidence=$2
  manifest_heads="$TMPROOT/manifest-heads.$$"
  evidence_heads="$TMPROOT/evidence-heads.$$"

  for item in "$manifest:$manifest_heads" "$evidence:$evidence_heads"; do
    source_file=${item%%:*}
    output_file=${item#*:}
    awk '
      /^REPOSITORY:$/ { inside = 1; path = head = ""; next }
      inside && /^Path: / { path = substr($0, 7); next }
      inside && /^Head: / { head = substr($0, 7); next }
      /^END_REPOSITORY$/ {
        if (!inside || path == "" || head == "") exit 2
        print path " | " head
        inside = 0
      }
      END { if (inside) exit 2 }
    ' "$source_file" | sort >"$output_file" || return 1
    [ -s "$output_file" ] || return 1
  done

  cmp -s "$manifest_heads" "$evidence_heads"
}

pending_ids_closed_by_evidence_review() {
  ledger=$1
  phase=$2
  verdict_line=$3
  pending=$(grep -E "^Phase $phase: acceptance pending —" "$ledger" | tail -1) || return 1
  pending_ids=${pending#*findings: }
  pending_ids=${pending_ids%% — acceptance:*}
  verdicts=$(sed -n "${verdict_line}p" "$ledger")
  verdicts=${verdicts#*verdicts — }

  for finding in $pending_ids; do
    status=$(printf '%s\n' "$verdicts" | tr ';' '\n' | awk -v id="$finding" '$1 == id { print $2; exit }')
    case "$status" in addressed|invalid) ;; *) return 1;; esac
  done
}

acceptance_verified_covers_pending() {
  ledger=$1
  phase=$2
  verified_line=$3
  pending=$(grep -E "^Phase $phase: acceptance pending —" "$ledger" | tail -1) || return 1
  pending_ids=${pending#*findings: }
  pending_ids=${pending_ids%% — acceptance:*}
  verified=$(sed -n "${verified_line}p" "$ledger")
  verified_ids=${verified#*findings: }
  verified_ids=${verified_ids%% — acceptance:*}

  for finding in $pending_ids; do
    case " $verified_ids " in *" $finding "*) ;; *) return 1;; esac
  done
}

intermediate_post_gate_transition() {
  ledger=$1
  phase=$2
  scope=$3

  if grep -qE "^Phase $phase: accepted — " "$ledger"; then
    printf '%s\n' 'choose-phase'
    return
  fi

  pending_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance pending —")
  received_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance evidence received —")
  verified_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance verified —")
  pending_closed=0
  if [ "$pending_line" -gt 0 ] && [ "$verified_line" -gt "$pending_line" ] && acceptance_verified_covers_pending "$ledger" "$phase" "$verified_line"; then
    pending_closed=1
  fi
  if [ "$pending_line" -gt 0 ] && [ "$pending_closed" -eq 0 ]; then
    if [ "$pending_line" -gt "$received_line" ]; then
      printf '%s\n' 'await-evidence'
      return
    fi
    ranges_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ repositories —")
    verdict_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ — verdicts —")
    outcome_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ — (open:|clean)")
    if [ "$ranges_line" -lt "$received_line" ] || [ "$verdict_line" -le "$ranges_line" ] || [ "$outcome_line" -le "$verdict_line" ]; then
      printf '%s\n' 'evidence-review'
      return
    fi
    if ! pending_ids_closed_by_evidence_review "$ledger" "$phase" "$verdict_line"; then
      printf '%s\n' 'await-evidence'
      return
    fi
    printf '%s\n' 'append-acceptance-verified'
    return
  fi

  open_line=$(grep -E "^Phase $phase: (re-review [0-9]+|evidence review [0-9]+) — open: " "$ledger" | tail -1) || true
  if [ -z "$open_line" ]; then
    printf 'append:Phase %s: accepted — %s\n' "$phase" "$scope"
    return
  fi
  open_ids=${open_line#*open: }
  open_ids=${open_ids%% — coverage:*}
  carry=''

  for finding in $open_ids; do
    if grep -qF "Phase $phase: review: parked — $finding —" "$ledger"; then
      continue
    fi
    severity=$(awk -F ' *\\| *' -v id="$finding" '$1 == id { print $2; exit }' "$ledger")
    case "$severity" in
      critical|important)
        case "$open_line" in
          *'evidence review '*)
            if grep -qE "^Phase $phase: fix round 1 repositories —" "$ledger"; then
              printf '%s\n' 'user-gate'
            else
              printf '%s\n' 'fix-round-1'
            fi
            ;;
          *) printf '%s\n' 'user-gate';;
        esac
        return
        ;;
      minor)
        carry="${carry}${carry:+ }$finding"
        ;;
      *) return 1;;
    esac
  done

  if [ -n "$carry" ]; then
    printf 'append:Phase %s: accepted — %s — carry %s\n' "$phase" "$scope" "$carry"
  else
    printf 'append:Phase %s: accepted — %s\n' "$phase" "$scope"
  fi
}

last_matching_line() {
  file=$1
  pattern=$2
  line=$(grep -nE "$pattern" "$file" | tail -1 | cut -d: -f1) || true
  printf '%s\n' "${line:-0}"
}

final_transition() {
  ledger=$1
  phase=$2
  current_head=$3

  pending_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance pending —")
  received_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance evidence received —")
  verified_line=$(last_matching_line "$ledger" "^Phase $phase: acceptance verified —")
  if [ "$pending_line" -gt "$received_line" ]; then
    printf '%s\n' 'await-evidence'
    return
  fi

  ranges_line=$(last_matching_line "$ledger" "^Phase $phase: (final review|re-review [0-9]+|evidence review [0-9]+) repositories —")
  [ "$ranges_line" -gt 0 ] || { printf '%s\n' 'final-review'; return; }
  ranges=$(sed -n "${ranges_line}p" "$ledger")
  case "$ranges" in
    *"..$current_head]"*) ;;
    *) printf '%s\n' 'full-final-review'; return;;
  esac

  coverage_line=$(last_matching_line "$ledger" "^Phase $phase: (review — final (clean|findings)|re-review [0-9]+ — (clean|open:.*) — coverage:|evidence review [0-9]+ — (clean|open:.*) — coverage:)")
  [ "$coverage_line" -gt 0 ] || { printf '%s\n' 'final-review'; return; }

  pending_closed=0
  if [ "$pending_line" -gt 0 ] && [ "$verified_line" -gt "$pending_line" ] && acceptance_verified_covers_pending "$ledger" "$phase" "$verified_line"; then
    pending_closed=1
  fi
  if [ "$pending_line" -gt 0 ] && [ "$pending_closed" -eq 0 ]; then
    evidence_ranges_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ repositories —")
    verdict_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ — verdicts —")
    evidence_coverage_line=$(last_matching_line "$ledger" "^Phase $phase: evidence review [0-9]+ — (clean|open:.*) — coverage:")
    if [ "$evidence_ranges_line" -lt "$received_line" ] || [ "$verdict_line" -le "$evidence_ranges_line" ] || [ "$evidence_coverage_line" -le "$verdict_line" ]; then
      printf '%s\n' 'evidence-review'
      return
    fi
    if ! pending_ids_closed_by_evidence_review "$ledger" "$phase" "$verdict_line"; then
      printf '%s\n' 'await-evidence'
      return
    fi
    evidence_coverage=$(sed -n "${evidence_coverage_line}p" "$ledger")
    case "$evidence_coverage" in
      *' — open:'*) printf '%s\n' 'final-routing'; return;;
    esac
    printf '%s\n' 'append-acceptance-verified'
    return
  fi

  coverage=$(sed -n "${coverage_line}p" "$ledger")
  case "$coverage" in
    *'final findings'*|*' — open:'*) printf '%s\n' 'final-routing'; return;;
  esac

  accepted_line=$(last_matching_line "$ledger" "^Phase $phase: accepted —")
  if [ "$accepted_line" -lt "$coverage_line" ]; then
    printf '%s\n' 'append-final-accepted'
  else
    printf '%s\n' 'complete'
  fi
}

next_fix_round() {
  ledger=$1
  phase=$2
  awk -v prefix="Phase $phase: fix round " '
    index($0, prefix) == 1 && / repositories —/ {
      value = substr($0, length(prefix) + 1)
      sub(/ .*/, "", value)
      if (value + 0 > max) max = value + 0
    }
    END { print max + 1 }
  ' "$ledger"
}

t01_layout_stays_lean() {
  [ -x "$IMPLEMENT_DIRECTORY" ] || return 1
  [ -x "$REVIEW_PACKAGE" ] || return 1
  [ "$(find "$SCRIPTS" -maxdepth 1 -type f | wc -l | tr -d ' ')" = 2 ] || return 1
  [ ! -e "$AGENTS/runtime" ] || return 1
  [ "$(find "$AGENTS" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')" = 4 ]
}

t02_skill_routes_compact_dispatch() {
  contains "$SKILL" 'name: implement' || return 1
  contains "$SKILL" 'role-contract path, dispatch-manifest path' || return 1
  contains "$SKILL" 'Keep this prompt below 1 KB.' || return 1
  contains "$SKILL" 'Manifests name finding ids and source anchors' || return 1
  contains "$SKILL" 'Semantic changes append a ruling; routine package regeneration creates only a successor manifest.' || return 1
  contains "$SKILL" 'The controller alone writes `PROGRESS_FILE` and dispatch manifests.' || return 1
  contains "$SKILL" 'Implementer and fixer may write only their manifest-named evidence path' || return 1
  not_contains "$SKILL" "fill the named agent template's placeholders" || return 1
  not_contains "$SKILL" 'prompt: |' || return 1

  prompt=$(printf 'Read and follow the role contract:\n%s\n\nExecute this dispatch:\n%s\n\nReturn only the format required by the role contract.\n' \
    '/skills/implement/agents/implementer.md' '/tmp/run/dispatch/P1-implement-D1.md')
  prompt_bytes=$(printf '%s' "$prompt" | wc -c | tr -d ' ')
  [ "$prompt_bytes" -lt 1024 ] || return 1
  for historical_build_bytes in 28000 62000 71000; do
    [ "$prompt_bytes" -lt "$historical_build_bytes" ] || return 1
  done
}

